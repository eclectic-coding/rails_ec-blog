<%= content_for :title, "Projects" %>

<div class="row mb-4">
  <div class="col-sm-8 mx-auto text-center">
    <h1 class="article-feed-header">Projects</h1>
    <p class="text-muted">Open-source gems and tools I maintain.</p>
  </div>
</div>

<div class="col-md-10 mx-auto" data-controller="infinite-scroll">
  <div class="row g-4 mb-5" id="projects" data-infinite-scroll-target="entries">
    <% @projects.each do |project| %>
      <%= render partial: "project", locals: { project: project } %>
    <% end %>

    <% if @projects.empty? %>
      <div class="col-12 text-center text-muted py-5">
        <p>No projects yet.</p>
      </div>
    <% end %>
  </div>

  <% if @pagy.next %>
    <div id="pagination"
         data-infinite-scroll-target="pagination"
         data-infinite-scroll-url-value="<%= projects_path(page: @pagy.next) %>"
         class="d-flex justify-content-center my-4">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading more projects...</span>
      </div>
    </div>
  <% end %>
</div>