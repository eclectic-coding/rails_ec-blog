<%= content_for :title, "Sessions" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Sessions</h1>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>User</th>
          <th>IP Address</th>
          <th>User Agent</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @sessions.each do |session| %>
          <tr class="<%= 'table-active' if session == Current.session %>">
            <td><%= session.user.email_address %></td>
            <td class="text-muted small"><%= session.ip_address.presence || "—" %></td>
            <td class="text-muted small text-truncate" style="max-width: 260px;"><%= session.user_agent.presence || "—" %></td>
            <td class="text-muted small"><%= session.created_at.to_fs(:long) %></td>
            <td class="text-end">
              <% if session == Current.session %>
                <span class="badge bg-secondary">current</span>
              <% else %>
                <%= button_to "Revoke", dashboard_session_path(session), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "Revoke this session?" } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-3">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
<% end %>