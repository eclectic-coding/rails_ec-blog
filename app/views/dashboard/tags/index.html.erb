<%= content_for :title, "Tags" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Tags</h1>
  <%= link_to "New Tag", new_dashboard_tag_path, class: "btn btn-primary" %>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Articles</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr>
            <td><%= tag.display_name %></td>
            <td class="text-muted small"><%= tag.articles.count %></td>
            <td class="text-end">
              <%= link_to "Edit", edit_dashboard_tag_path(tag), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Delete", dashboard_tag_path(tag), method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    form: { data: { turbo_confirm: "Delete tag #{tag.display_name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-3">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
<% end %>