<%= content_for :title, "Users" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Users</h1>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Email</th>
          <th>Admin</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.email_address, dashboard_user_path(user) %></td>
            <td>
              <% if user.admin? %>
                <span class="badge bg-primary">Admin</span>
              <% else %>
                <span class="badge bg-secondary">User</span>
              <% end %>
            </td>
            <td class="text-muted small"><%= user.created_at.to_fs(:long) %></td>
            <td class="text-end">
              <%= link_to "Edit", edit_dashboard_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-3">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
<% end %>
