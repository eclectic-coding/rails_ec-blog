<% flash.each do |msg_type, message| %>
  <% klass = bootstrap_class_for(msg_type) %>
  <% bg_class = klass.start_with?("alert-") ? klass.sub(/^alert-/, "bg-") : "bg-#{klass}" %>
  <div class="toast align-items-center text-black-50 <%= bg_class %>"
       role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
    <div class="d-flex">
      <div class="toast-body">
        <%= message %>
      </div>
      <button type="button" class="btn-close btn-close-dark me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
<% end %>
