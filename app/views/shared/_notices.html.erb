<% flash.each do |msg_type, message| %>
  <% klass = bootstrap_class_for(msg_type) %>
  <%
    # Map alert classes to Bootstrap toast classes
    toast_class = case klass
      when "alert-success" then "text-bg-success"
      when "alert-danger" then "text-bg-danger"
      when "alert-warning" then "text-bg-warning"
      when "alert-info" then "text-bg-info"
      else "text-bg-secondary"
    end
  %>
  <div class="toast align-items-center border-0 <%= toast_class %>"
       role="alert" aria-live="assertive" aria-atomic="true"
       data-bs-autohide="true" data-bs-delay="5000">
    <div class="d-flex">
      <div class="toast-body">
        <%= message %>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
<% end %>
