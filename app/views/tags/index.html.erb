<div class="row">
  <div class="col-sm-8 mx-auto mb-3">
    <h1 class="article-feed-header text-center mb-4">All Tags</h1>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
      <% @tags.each do |tag| %>
        <%= link_to tag_path(tag), class: 'text-decoration-none' do %>
          <span class="badge rounded-pill text-bg-primary fs-5 py-2 px-3">
            <%= tag.name %>
            <span class="badge rounded-pill text-bg-light text-dark ms-1"><%= tag.articles.count %></span>
          </span>
        <% end %>
      <% end %>
    </div>

    <% if @tags.empty? %>
      <div class="alert alert-info text-center mt-4" role="alert">
        No tags have been created yet.
      </div>
    <% end %>
  </div>
</div>

