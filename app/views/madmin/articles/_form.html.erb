<div class="madmin-form-container">
<%= form_with model: [:madmin, record], html: { multipart: true }, local: true do |form| %>
  <% if form.object.errors.any? %>
    <div class="alert alert-danger">
      <div>There <%= pluralize form.object.errors.full_messages.count, "error" %> with your submission:</div>
      <ul>
        <% form.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :tag_ids, "Tags" %>
    <%= form.collection_select :tag_ids, Tag.ordered, :id, :display_name,
        {},
        { multiple: true, class: "form-input", data: { controller: "select" } } %>
    <p class="form-description">Type to search. Select multiple tags.</p>
  </div>

  <div class="madmin-form-row">
    <div class="form-group">
      <%= form.label :is_published, "Published?" %>
      <%= form.check_box :is_published %>
    </div>

    <div class="form-group">
      <%= form.label :published_at, "Published date" %>
      <%= form.date_field :published_at, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :image %>
    <% if record.image.attached? %>
      <%= image_tag record.image, class: "madmin-image-preview" %>
    <% end %>
    <%= form.file_field :image, class: "form-input", accept: "image/jpeg,image/png,image/webp,image/gif" %>
    <p class="form-description">JPEG, PNG, WEBP or GIF, max 5 MB.</p>
  </div>

  <div class="form-group">
    <%= form.label :content %>
    <%= form.lexxy_rich_text_area :content %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", (record.persisted? ? resource.show_path(record) : resource.index_path), class: "btn" %>
<% end %>
</div>