<%= turbo_stream.append "articles" do %>
  <% @articles.each do |post| %>
    <%= render partial: "article", locals: { article: post } %>
  <% end %>
<% end %>


<% if @pagy.next %>
  <%= turbo_stream.replace "pagination" do %>
    <div id="pagination"
         data-infinite-scroll-target="pagination"
         data-infinite-scroll-url-value="<%= articles_path(page: @pagy.next) %>"
         class="d-flex justify-content-center my-4">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading more articles...</span>
      </div>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.remove "pagination" %>
<% end %>


