<div id="article-image-area-<%= article.id %>" class="article-image-area position-relative">
  <% if article.image.attached? && article.persisted? %>
    <%= image_tag url_for(article.image.variant(resize_to_limit: [80, 60])),
        class: 'article-thumb',
        data: { 'image-picker-target': 'preview' },
        alt: (article.title.presence || 'Article image') %>
    <button type="button" class="remove-image-btn btn btn-sm btn-danger" aria-label="Remove image"
            data-action="click->image-picker#removeImage"
            data-remove-url="<%= remove_image_article_path(article) %>"
            data-confirm="Are you sure you want to remove the image?">✕</button>
  <% else %>
    <img src="" class="article-thumb d-none" data-image-picker-target="preview" alt="preview">
  <% end %>
</div>
