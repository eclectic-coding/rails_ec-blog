<%= form_with(model: article, local: true, html: { multipart: true }) do |form| %>
  <% if article.errors.any? %>
    <div class="alert alert-danger" role="alert" id="error_explanation">
      <h4 class="alert-heading"><%= pluralize(article.errors.count, "error") %> prohibited saving changes:</h4>
      <ul class="mb-0">
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: 'form-label' %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :tag_ids, "Tags (select or create new)", class: 'form-label' %>
    <%= form.collection_select :tag_ids, Tag.ordered, :id, :display_name,
        {},
        {
          multiple: true,
          class: 'form-select',
          data: { controller: 'tom-select' }
        }
    %>
    <div class="form-text">
      Type to search existing tags or create a new one by typing and pressing Enter.
    </div>
  </div>

  <div class="row">
    <div class="col-3 d-flex align-items-center ms-2">
      <div class="mb-3 form-check">
        <%= form.check_box :is_published, class: 'form-check-input' %>
        <%= form.label :is_published, class: 'form-check-label ms-2' %>
      </div>
    </div>

    <div class="col-4">
      <div class="mb-3">
        <%= form.label :published_at, "Published date", class: 'form-label' %>
        <%= form.date_field :published_at, class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :image, class: 'form-label' %>

    <div data-controller="image-picker"
         data-image-picker-direct-upload-url-value="<%= rails_direct_uploads_url %>">

      <%# Hidden field receives the signed blob ID; disabled until a new selection is made -%>
      <%= form.hidden_field :image,
            id: 'article_image_signed_id',
            disabled: true,
            data: { 'image-picker-target': 'signedId' } %>

      <div class="d-flex align-items-start gap-2">
        <%# Choose / Change button + filename — grows to fill available space -%>
        <div class="flex-grow-1">
          <div class="input-group">
            <button type="button" class="btn btn-outline-secondary"
                    data-action="click->image-picker#openModal"
                    data-image-picker-target="chooseButton">
              <%= article.image.attached? ? 'Change Image' : 'Choose Image' %>
            </button>
            <input type="text" readonly class="form-control"
                   data-image-picker-target="filename"
                   aria-label="Selected image"
                   value="<%= article.image.attached? ? article.image.filename.to_s : 'No image selected' %>">
          </div>
          <div class="form-text">Choose from your image library or upload a new one.</div>
        </div>

        <%# Thumbnail preview at the right end of the row -%>
        <div class="flex-shrink-0">
          <% if article.persisted? %>
            <%= render 'articles/image_preview', article: article %>
          <% else %>
            <img src="" alt="preview" class="article-thumb d-none"
                 data-image-picker-target="preview">
          <% end %>
        </div>
      </div>

      <%# Image picker modal (Bootstrap 5 + Turbo Frame for library grid) -%>
      <%= render 'articles/image_picker_modal' %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :content, class: 'form-label' %>
    <%= form.lexxy_rich_text_area :content %>
  </div>

  <div class="mb-3">
    <% if article.persisted? %>
      <div class="float-end">
        <%= link_to 'Destroy', article, class: "text-danger", data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
      </div>
    <% end %>

    <div class="d-flex gap-2 align-items-center">
      <%= form.submit class: 'btn btn-primary' %>
      <% if article.persisted? %>
        <%= link_to "Cancel", article, class: "btn btn-link" %>
      <% else %>
        <%= link_to "Cancel", articles_path, class: "btn btn-link" %>
      <% end %>
    </div>
  </div>
<% end %>
