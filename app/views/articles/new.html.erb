<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<% end %>

<div class="row">
  <div class="col-md-6 mx-auto">
    <div class="card mb-3">
      <div class="card-header bg-white border-0">
        <h1>New article</h1>

        <div class="card-body">
          <%= render 'form', article: @article %>
        </div>
      </div>
    </div>
  </div>
</div>
