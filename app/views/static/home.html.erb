<div class="row align-items-center justify-content-center">
  <div class="d-none d-md-block col-md-2 text-center">
    <%= image_tag "profile-pic.jpg",
                  alt: "Profile photo",
                  class: "profile-pic img-fluid rounded-circle" %>
  </div>
  <div class="col-12 col-md-5">
    <h1 class="text-primary mb-0">Chuck Smith</h1>
    <p class="lead">Senior Software Engineer</p>
  </div>

  <div class="col-12 col-md-7">
    <div class="lead mt-4 ps-0 ps-md-5">
      <p>Paragraph</p>
      <p>Paragraph</p>
    </div>
  </div>
</div>

<% if @gems.any? %>
  <section class="mt-5">
    <h2 class="h4 mb-4">Open Source Gems</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @gems.each do |gem| %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h3 class="h6 card-title mb-0 text-primary fw-semibold"><%= gem["name"] %></h3>
                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2 flex-shrink-0">v<%= gem["version"] %></span>
              </div>
              <p class="card-text small text-muted flex-grow-1"><%= truncate(gem["info"], length: 140) %></p>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted"><%= number_with_delimiter(gem["downloads"]) %> downloads</small>
                <div class="d-flex gap-2">
                  <%= link_to "RubyGems", gem["project_uri"], class: "btn btn-sm btn-outline-secondary", target: "_blank", rel: "noopener noreferrer" %>
                  <% if gem["homepage_uri"].present? %>
                    <%= link_to "GitHub", gem["homepage_uri"], class: "btn btn-sm btn-outline-secondary", target: "_blank", rel: "noopener noreferrer" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
